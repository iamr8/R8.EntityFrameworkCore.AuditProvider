<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <IncludeSymbols>true</IncludeSymbols>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- NuGet package metadata. Kept in sync with the main package. Version is the source of truth for
       releases: bump it on develop, and the release workflow publishes it when master is updated. -->
    <PropertyGroup>
        <Version>1.3.0</Version>
        <PackageId>R8.EntityFrameworkCore.AuditProvider.Abstractions</PackageId>
        <Title>R8.EntityFrameworkCore.AuditProvider.Abstractions</Title>
        <Authors>iamr8</Authors>
        <Company>iamr8</Company>
        <Description>Abstractions (audit models and contracts) for R8.EntityFrameworkCore.AuditProvider, providing comprehensive change tracking with deep insights.</Description>
        <PackageTags>ef;ef-core;audit;postgres;postgresql;mssql;sql</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright © iamr8</Copyright>
        <PackageProjectUrl>https://github.com/iamr8/R8.EntityFrameworkCore.AuditProvider</PackageProjectUrl>
        <RepositoryUrl>https://github.com/iamr8/R8.EntityFrameworkCore.AuditProvider</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- Unlike the main package, the Abstractions are pure data models/contracts with no reflection-based
       serialization, so they are genuinely Native-AOT and trim safe: net8/net10 get the AOT analyzer,
       net6 gets trim analysis. The library builds warning-free under both. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <LangVersion>10.0</LangVersion>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <LangVersion>12.0</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <LangVersion>14.0</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="[8.0.0,10.0)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="R8.EntityFrameworkCore.AuditProvider"/>
        <InternalsVisibleTo Include="R8.EntityFrameworkCore.AuditProvider.Tests"/>
    </ItemGroup>

</Project>
